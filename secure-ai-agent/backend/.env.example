# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

# Port the backend server listens on
PORT=4000

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Bcrypt hash of the account password (NOT the plain password).
# Generate it once by running:
#   node hash-password.js "YourStrongPassword123!"
# and paste the printed hash below.
ACCOUNT_PASSWORD_HASH=replace_this_with_a_bcrypt_hash

# Minimum cosine similarity for a face match to count as "recognized".
# Higher = stricter. 0.90-0.94 is a reasonable starting range.
FACE_MATCH_THRESHOLD=0.92

# Your image generation provider's API key (used server-side only, never sent to the browser)
IMAGE_API_KEY=replace_with_your_image_api_key
