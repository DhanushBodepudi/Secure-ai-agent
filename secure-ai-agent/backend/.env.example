# Copy this file to ".env" in the backend folder and fill it in. Never share or upload ".env".

# Long random string that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Gemini key for chat, file analysis and documents
GEMINI_API_KEY=

# Optional: malware check for uploads (virustotal.com, free key)
VIRUSTOTAL_API_KEY=

# ---- Accounts ----
# Set to "false" to stop new people signing up
ALLOW_REGISTRATION=true
# Fair-use cap on AI requests per person per day
DAILY_AI_LIMIT=60
# One-time: set to "true", register YOUR account, then remove this line.
# It hands your old single-user chats, face and photos to the first account created.
CLAIM_LEGACY_DATA=false
# Face matching strictness. Smaller is stricter (0.5 is a safe default).
FACE_MAX_DISTANCE=0.5

# ---- Only when running on your own Windows laptop ----
# Turns on the quick-launch buttons and locking Windows when you walk away.
# KEEP THIS "false" ON ANY WEBSITE: those commands would run on the server.
ENABLE_LOCAL_CONTROLS=false

# ---- For going live later (leave alone for now) ----
# NODE_ENV=production
# DATA_DIR=/path/to/persistent/disk
# TRUST_PROXY=1
# PORT=4000
